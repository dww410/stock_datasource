{
  "enabled": true,
  "data_source": "tushare",
  "available_data_sources": [
    "tushare",
    "qmt"
  ],
  "rate_limit": 120,
  "timeout": 30,
  "retry_attempts": 3,
  "description": "TuShare A股日线行情数据",
  "cooling": {
    "rate_limit_seconds": 180,
    "ip_limit_seconds": 300
  },
  "schedule": {
    "frequency": "daily",
    "time": "18:00"
  },
  "parameters": {
    "max_empty_days": 5,
    "validate_prices": true,
    "require_ohlc": true
  },
  "parameters_schema": {
    "trade_date": {
      "type": "string",
      "format": "date",
      "required": true,
      "description": "Trade date in YYYYMMDD format"
    }
  }
}